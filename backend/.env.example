# AI API 配置 (支持任何 OpenAI 兼容 API)
# 当前使用 DeepSeek 官方 API
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=your-api-key-here
AI_MODEL=deepseek-chat
AI_MAX_TOKENS=4096

# 如需使用本地 Ollama（无需外网）:
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=gpt-oss:20b
# AI_MAX_TOKENS=16384

# 如需使用硅基流动 (SiliconFlow):
# AI_BASE_URL=https://api.siliconflow.cn/v1
# AI_API_KEY=your-siliconflow-api-key
# AI_MODEL=deepseek-ai/DeepSeek-V3

# 如需使用 OpenRouter (免费模型可用):
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=your-openrouter-api-key
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---------- JWT 认证配置 ----------
JWT_SECRET_KEY=change-this-to-a-random-secret-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Stripe 支付配置 ----------
# 在 Stripe Dashboard -> Developers -> API keys 获取
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# 在 Dashboard -> Developers -> Webhooks -> 签名密钥
STRIPE_WEBHOOK_SECRET=whsec_xxx
# 在 Dashboard -> Products 创建产品后获取 Price ID
STRIPE_MONTHLY_PRICE_ID=price_xxx
STRIPE_YEARLY_PRICE_ID=price_xxx

# ---------- OAuth 配置（可选，用于第三方登录）----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- 应用配置 ----------
APP_URL=http://localhost:5173
